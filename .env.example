# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.

# desarrollo | produccion  (cualquier otro valor detiene el arranque)
NEXO_ENTORNO=desarrollo

# Obligatoria en producción: al menos 32 caracteres aleatorios.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXO_CLAVE_SECRETA=

# Base de datos. Vacío = SQLite en var/nexo.db (desarrollo). En producción, PostgreSQL:
# NEXO_BASE_DATOS_URL=postgresql+psycopg://nexo:CAMBIAR@db:5432/nexo
NEXO_BASE_DATOS_URL=

# URL con la que los usuarios abren Nexo (se usa en los enlaces de los correos)
NEXO_URL_PUBLICA=http://localhost:8000

# Dominios de correo aceptados en el registro (vacío = cualquiera). Ejemplo: ine.gob.gt
NEXO_DOMINIOS_CORREO_PERMITIDOS=

# Correo saliente (opcional). Sin SMTP, en desarrollo los correos de verificación se ven en pantalla.
NEXO_SMTP_HOST=
NEXO_SMTP_PUERTO=587
NEXO_SMTP_USUARIO=
NEXO_SMTP_CLAVE=
NEXO_SMTP_REMITENTE=no-responder@ine.gob.gt

# Seguridad (valores por defecto recomendados)
NEXO_ROLES_CON_MFA_OBLIGATORIO=admin_ti,seguridad
NEXO_LOGIN_MAX_INTENTOS=5
NEXO_BLOQUEO_MINUTOS=15
# NEXO_SESION_INACTIVIDAD=30          # minutos; por defecto 30 en producción y 240 en desarrollo
# NEXO_COOKIE_SEGURA=true             # por defecto: sí en producción (requiere HTTPS)
# NEXO_BUZON_DEMO=false               # por defecto: solo en desarrollo

# Secreto estadístico: mínimo de observaciones por celda publicada
NEXO_K_MINIMO=3

# Automatizaciones (un solo proceso debe tener el programador activo)
NEXO_PROGRAMADOR_ACTIVO=true

# Solo para Docker Compose: contraseña de la base PostgreSQL local (genera una aleatoria)
# python -c "import secrets; print(secrets.token_urlsafe(24))"
NEXO_BD_CLAVE=
